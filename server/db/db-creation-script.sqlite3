PRAGMA FOREIGN_KEYS = 0;
DROP TABLE IF EXISTS `USER`;
DROP TABLE IF EXISTS `BOOK`;
DROP TABLE IF EXISTS `SONG`;
DROP TABLE IF EXISTS `SONG_VARIANT`;
DROP TABLE IF EXISTS `SONG_IMAGE_DATA`;
DROP TABLE IF EXISTS `SONG_IMAGES`;
DROP TABLE IF EXISTS `VARIANT_LAST_OPENED_DATE`;
DROP TABLE IF EXISTS `PLAYLIST`;
DROP TABLE IF EXISTS `SONG_IN_PLAYLIST`;
DROP TABLE IF EXISTS `USER_SONG_SEARCH`;
DROP TABLE IF EXISTS `PLAYLIST_TEMPLATE`;
DROP TABLE IF EXISTS `PLAYLIST_TEMPLATE_ITEM`;
DROP TABLE IF EXISTS `USER_HAS_IN_LIBRARY`;
DROP TABLE IF EXISTS `BOOK_CUSTOM_PERMISSION`;
DROP TABLE IF EXISTS `LOGGED_IN_DEVICES`;
DROP TABLE IF EXISTS `UPDATES_USER_DATA`;
DROP TABLE IF EXISTS `UPDATES_PLAYLIST_TEMPLATE`;
DROP TABLE IF EXISTS `UPDATES_LIBRARY`;
DROP TABLE IF EXISTS `UPDATES_SONG_SEARCH`;
DROP TABLE IF EXISTS `UPDATES_CUSTOM_PERMISSION`;
DROP TABLE IF EXISTS `UPDATES_PLAYLIST`;
DROP TABLE IF EXISTS `UPDATES_BOOK_INFO`;
DROP TABLE IF EXISTS `UPDATES_VARIANT_OPEN`;
DROP TABLE IF EXISTS `UPDATES_SONG`;
DROP TABLE IF EXISTS `UPDATES_SONG_VARIANT`;
DROP TABLE IF EXISTS `UPDATES_SONG_IMAGE_DATA`;
PRAGMA FOREIGN_KEYS = 1;

CREATE TABLE `USER` (
	`Id` INTEGER AUTO_INCREMENT  NOT NULL,
	`Username` VARCHAR(30) NOT NULL,
	`Salt` INTEGER NOT NULL,
	`Hash` CHAR(256) NOT NULL,
	`Email` TEXT NOT NULL,
	`Name` TEXT NOT NULL,
	`Surname` TEXT NOT NULL,
	`Language` TEXT NOT NULL,
	`OfflineData` BOOLEAN NOT NULL,
	`Column1` INTEGER NOT NULL,
	PRIMARY KEY (`Id`)
);

CREATE TABLE `BOOK` (
	`Id` INTEGER NOT NULL,
	`Owner` INTEGER NOT NULL,
	`Title` TEXT NOT NULL,
	`Description` TEXT NOT NULL,
	`GeneralPermission` CHAR,
	`Cover` BLOB,
	`UnconfirmedNewOwner` INTEGER,
	PRIMARY KEY (`Id`),
	FOREIGN KEY (`Owner`) REFERENCES `USER`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`UnconfirmedNewOwner`) REFERENCES `USER`(`Id`) ON DELETE SET NULL
);

CREATE TABLE `SONG` (
	`Id` INTEGER AUTO_INCREMENT NOT NULL,
	`BookId` INTEGER NOT NULL,
	`Title` TEXT NOT NULL,
	PRIMARY KEY (`Id`),
	FOREIGN KEY (`BookId`) REFERENCES `BOOK`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `SONG_VARIANT` (
	`Id` INTEGER AUTO_INCREMENT NOT NULL,
	`SongId` INTEGER NOT NULL,
	`Name` TEXT NOT NULL,
	`Notes` TEXT NOT NULL,
	PRIMARY KEY (`Id`),
	FOREIGN KEY (`SongId`) REFERENCES `SONG`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `SONG_IMAGE_DATA` (
	`Id` INTEGER AUTO_INCREMENT NOT NULL,
	`SongId` INTEGER NOT NULL,
	`VariantId` INTEGER NOT NULL,
	`Data` BLOB NOT NULL,
	PRIMARY KEY (`Id`)
);

CREATE TABLE `SONG_IMAGES` (
	`Id` INTEGER AUTO_INCREMENT NOT NULL,
	`VariantId` INTEGER NOT NULL,
	`PageNumber` INTEGER NOT NULL,
	`ImageId` INTEGER NOT NULL,
	`Annotations` TEXT,
	PRIMARY KEY (`VariantId`, `PageNumber`),
	FOREIGN KEY (`VariantId`) REFERENCES `SONG_VARIANT`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`ImageId`) REFERENCES `SONG_IMAGE_DATA`(`Id`) ON DELETE RESTRICT
);

CREATE TABLE `VARIANT_LAST_OPENED_DATE` (
	`UserId` INTEGER NOT NULL,
	`VariantId` INTEGER NOT NULL,
	`Date` DATE NOT NULL,
	PRIMARY KEY (`UserId`, `VariantId`),
	FOREIGN KEY (`VariantId`) REFERENCES `SONG_VARIANT`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`UserId`) REFERENCES `USER`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `PLAYLIST` (
	`Id` INTEGER AUTO_INCREMENT NOT NULL,
	`Owner` INTEGER NOT NULL,
	`Date` DATE NOT NULL,
	`Name` TEXT NOT NULL,
	PRIMARY KEY (`Id`),
	FOREIGN KEY (`Owner`) REFERENCES `USER`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `SONG_IN_PLAYLIST` (
	`PlaylistId` INTEGER NOT NULL,
	`Label` VARCHAR(20) NOT NULL,
	`SongId` INTEGER,
	`Index` INTEGER NOT NULL,
	`Color` VARCHAR(7) NOT NULL,
	PRIMARY KEY (`PlaylistId`, `Label`),
	FOREIGN KEY (`PlaylistId`) REFERENCES `PLAYLIST`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`SongId`) REFERENCES `SONG`(`Id`) ON DELETE SET NULL
);

CREATE TABLE `USER_SONG_SEARCH` (
	`Id AUTO_INCREMENT` INTEGER NOT NULL,
	`UserId` INTEGER NOT NULL,
	`SongId` INTEGER,
	`Date` DATE NOT NULL,
	PRIMARY KEY (`Id AUTO_INCREMENT`),
	FOREIGN KEY (`UserId`) REFERENCES `USER`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`SongId`) REFERENCES `SONG`(`Id`) ON DELETE SET NULL
);

CREATE TABLE `PLAYLIST_TEMPLATE` (
	`Id` INTEGER AUTO_INCREMENT NOT NULL,
	`Name` VARCHAR(30) NOT NULL,
	`Owner` INTEGER NOT NULL,
	PRIMARY KEY (`Id`),
	FOREIGN KEY (`Owner`) REFERENCES `USER`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `PLAYLIST_TEMPLATE_ITEM` (
	`Id` INTEGER AUTO_INCREMENT NOT NULL,
	`Label` VARCHAR(20) NOT NULL,
	`TemplateId` INTEGER NOT NULL,
	`Index` INTEGER NOT NULL,
	`Color` VARCHAR(7) NOT NULL,
	PRIMARY KEY (`Id`),
	FOREIGN KEY (`TemplateId`) REFERENCES `PLAYLIST_TEMPLATE`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `USER_HAS_IN_LIBRARY` (
	`UserId` INTEGER NOT NULL,
	`BookId` INTEGER NOT NULL,
	`Favorite` BOOLEAN NOT NULL,
	PRIMARY KEY (`UserId`, `BookId`),
	FOREIGN KEY (`UserId`) REFERENCES `USER`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`BookId`) REFERENCES `BOOK`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `BOOK_CUSTOM_PERMISSION` (
	`UserId` INTEGER NOT NULL,
	`BookId` INTEGER NOT NULL,
	`Permission` CHAR NOT NULL,
	PRIMARY KEY (`UserId`, `BookId`),
	FOREIGN KEY (`UserId`) REFERENCES `USER`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`BookId`) REFERENCES `BOOK`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `LOGGED_IN_DEVICES` (
	`Id` INTEGER AUTO_INCREMENT NOT NULL,
	`Owner` INTEGER NOT NULL,
	PRIMARY KEY (`Id`),
	FOREIGN KEY (`Owner`) REFERENCES `USER`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `UPDATES_USER_DATA` (
	`DeviceId` INTEGER NOT NULL,
	PRIMARY KEY (`DeviceId`),
	FOREIGN KEY (`DeviceId`) REFERENCES `LOGGED_IN_DEVICES`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `UPDATES_PLAYLIST_TEMPLATE` (
	`Id AUTO_INCREMENT` INTEGER NOT NULL,
	`DeviceId` INTEGER NOT NULL,
	`TemplateId` INTEGER,
	PRIMARY KEY (`Id AUTO_INCREMENT`),
	FOREIGN KEY (`DeviceId`) REFERENCES `LOGGED_IN_DEVICES`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`TemplateId`) REFERENCES `PLAYLIST_TEMPLATE`(`Id`) ON DELETE SET NULL
);

CREATE TABLE `UPDATES_LIBRARY` (
	`DeviceId` INTEGER NOT NULL,
	PRIMARY KEY (`DeviceId`),
	FOREIGN KEY (`DeviceId`) REFERENCES `LOGGED_IN_DEVICES`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `UPDATES_SONG_SEARCH` (
	`DeviceId` INTEGER NOT NULL,
	PRIMARY KEY (`DeviceId`),
	FOREIGN KEY (`DeviceId`) REFERENCES `LOGGED_IN_DEVICES`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `UPDATES_CUSTOM_PERMISSION` (
	`DeviceId` INTEGER NOT NULL,
	`BookId` INTEGER NOT NULL,
	PRIMARY KEY (`DeviceId`, `BookId`),
	FOREIGN KEY (`DeviceId`) REFERENCES `LOGGED_IN_DEVICES`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`BookId`) REFERENCES `BOOK`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `UPDATES_PLAYLIST` (
	`Id AUTO_INCREMENT` INTEGER NOT NULL,
	`DeviceId` INTEGER NOT NULL,
	`PlaylistId` INTEGER,
	PRIMARY KEY (`Id AUTO_INCREMENT`),
	FOREIGN KEY (`DeviceId`) REFERENCES `LOGGED_IN_DEVICES`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`PlaylistId`) REFERENCES `PLAYLIST`(`Id`) ON DELETE SET NULL
);

CREATE TABLE `UPDATES_BOOK_INFO` (
	`Id AUTO_INCREMENT` INTEGER NOT NULL,
	`DeviceId` INTEGER NOT NULL,
	`BookId` INTEGER,
	PRIMARY KEY (`Id AUTO_INCREMENT`),
	FOREIGN KEY (`DeviceId`) REFERENCES `LOGGED_IN_DEVICES`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`BookId`) REFERENCES `BOOK`(`Id`) ON DELETE SET NULL
);

CREATE TABLE `UPDATES_VARIANT_OPEN` (
	`DeviceId` INTEGER NOT NULL,
	`Column1` INTEGER NOT NULL,
	PRIMARY KEY (`DeviceId`),
	FOREIGN KEY (`DeviceId`) REFERENCES `LOGGED_IN_DEVICES`(`Id`) ON DELETE CASCADE
);

CREATE TABLE `UPDATES_SONG` (
	`Id AUTO_INCREMENT` INTEGER NOT NULL,
	`DeviceId` INTEGER,
	`SongId` INTEGER,
	PRIMARY KEY (`Id AUTO_INCREMENT`),
	FOREIGN KEY (`DeviceId`) REFERENCES `LOGGED_IN_DEVICES`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`SongId`) REFERENCES `SONG`(`Id`) ON DELETE SET NULL
);

CREATE TABLE `UPDATES_SONG_VARIANT` (
	`Id AUTO_INCREMENT` INTEGER NOT NULL,
	`DeviceId` INTEGER NOT NULL,
	`VariantId` INTEGER,
	PRIMARY KEY (`Id AUTO_INCREMENT`),
	FOREIGN KEY (`DeviceId`) REFERENCES `LOGGED_IN_DEVICES`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`VariantId`) REFERENCES `SONG_VARIANT`(`Id`) ON DELETE SET NULL
);

CREATE TABLE `UPDATES_SONG_IMAGE_DATA` (
	`Id AUTO_INCREMENT` NUMBER NOT NULL,
	`DeviceId` INTEGER NOT NULL,
	`ImageId` INTEGER,
	PRIMARY KEY (`Id AUTO_INCREMENT`),
	FOREIGN KEY (`DeviceId`) REFERENCES `LOGGED_IN_DEVICES`(`Id`) ON DELETE CASCADE,
	FOREIGN KEY (`ImageId`) REFERENCES `SONG_IMAGE_DATA`(`Id`) ON DELETE SET NULL
);
